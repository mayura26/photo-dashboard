# Copy to .env for local runs (`make run` loads it).
# On Coolify, set these as service environment variables instead.

# Listen address (default :8080)
# ADDR=:8080

# Home coordinates for live Open-Meteo weather (omit to use seed weather)
WEATHER_LAT=49.2827
WEATHER_LON=-123.1207

# Poll interval (Go duration; default 15m)
# WEATHER_REFRESH=15m

# Shared secret for POST /internal/garmin (required for live Garmin ingest)
# HQ_INGEST_TOKEN=change-me

# --- Garmin sidecar (services/garmin/poller.py) ---
# Run separately: cd services/garmin && python -m venv .venv && .venv/Scripts/activate
#   pip install -r requirements.txt && python poller.py
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# GARMIN_TOKEN_DIR=./.garmin-tokens
# HQ_URL=http://localhost:8080
# HQ_INGEST_TOKEN=change-me
# GARMIN_REFRESH=15m
# GARMIN_DISPLAY_NAME=
